{
    "name": "lef-to/lslim",
    "description": "Utility files for Slim framework version 3.",
    "license": "MIT",
    "authors": [
        {
            "name": "Koji Ogawa",
            "email": "pierre@lef.to"
        },
        {
            "name": "Ryutaro Konagane",
            "email": "ryun@ryun.jp"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "slim/slim": "^4.15.2",
        "slim/csrf": "^1.0",
        "slim/flash": "^0.4.0",
        "illuminate/database": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/pagination": "^12.0",
        "monolog/monolog": "^3.9",
        "guzzlehttp/psr7": "^2.12.3",
        "respect/validation": "^2.4",
        "illuminate/events": "^12.0",
        "vlucas/phpdotenv": "^5.6",
        "pimple/pimple": "^3.2",
        "dflydev/fig-cookies": "^3.1",
        "twig/twig": "^3.27.0",
        "slim/twig-view": "^3.0",
        "illuminate/cache": "^12.0",
        "middlewares/trailing-slash": "^2.0",
        "middlewares/csp": "^3.0",
        "bramus/monolog-colored-line-formatter": "^3.1",
        "symfony/mailer": "^7.4.12",
        "symfony/mime": "^7.4.22 || ^8.1.10",
        "symfony/polyfill-intl-idn": "^1.38.1",
        "symfony/process": "^7.4.5",
        "slim/http-cache": "^1.2",
        "illuminate/config": "^12.19"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "LSlim\\": "src"
        }
    },
    "require-dev": {
        "nyholm/psr7-server": "^1.1.0",
        "nyholm/psr7": "^1.6.1",
        "illuminate/queue": "^12.0",
        "illuminate/bus": "^12.0",
        "illuminate/redis": "^12.0",
        "squizlabs/php_codesniffer": "^3.13.6"
    }
}

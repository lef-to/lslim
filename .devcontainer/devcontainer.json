{
    "name": "LSlim",
    "initializeCommand": [
        "docker", "build", "--pull", "--tag", "lslim-dev-app:local",
        "${localWorkspaceFolder}/.devcontainer"
    ],
    "dockerComposeFile": "../docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/lslim",
    "remoteUser": "vscode",
    "shutdownAction": "stopCompose",
    "postCreateCommand": "composer install --no-interaction --prefer-dist",
    "forwardPorts": [8000, "mailpit:8025"],
    "portsAttributes": {
        "8000": {
            "label": "Development web server",
            "onAutoForward": "silent"
        },
        "mailpit:8025": {
            "label": "Mailpit",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client"
            ],
            "settings": {
                "php.validate.executablePath": "/usr/local/bin/php"
            }
        }
    }
}
